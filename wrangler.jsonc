{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skein-admin",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "routes": [
    {
      "pattern": "skein-admin.skeinui.com",
      "custom_domain": true,
    },
  ],
}
